# Copy to .env (git-ignored) and adjust.

# Deployment environment: development (default) or production.
# production makes DATABASE_URL mandatory and requires it to be PostgreSQL;
# the app refuses to start rather than fall back to a read-only SQLite file.
# On Streamlit Community Cloud set both APP_ENV and DATABASE_URL in Secrets.
APP_ENV=development

# SQLite (default, zero-install):
DATABASE_URL=sqlite:///db/coverage.db

# PostgreSQL via docker-compose.yml (Checkpoint A/B):
# DATABASE_URL=postgresql+psycopg://attack_mapper:POSTGRES_PASSWORD@localhost:5432/attack_coverage
# POSTGRES_PASSWORD=your-strong-postgres-password
# POSTGRES_APP_PASSWORD=your-strong-app-password

# Migrating an existing SQLite database into PostgreSQL (Neon, Cloud SQL, the
# docker-compose service, ...):
#   PYTHONPATH=src ./.venv/Scripts/python.exe scripts/migrate_sqlite_to_postgres.py \
#       --postgres-url postgresql+psycopg://user:password@host/dbname
# Add --deep-verify to compare every row (ids and timestamps included), or
# --dry-run to plan without writing. Re-check later with --verify-only.

# Optional: SIEM_API_KEY for API authentication (if exposing API publicly)
# Generate with: openssl rand -hex 32
# SIEM_API_KEY=your-random-api-key